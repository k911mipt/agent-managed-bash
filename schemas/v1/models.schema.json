{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-managed-bash.dev/schema/v1/models.schema.json",
  "title": "ProtocolModels",
  "type": "object",
  "additionalProperties": false,
  "properties": { "job": { "$ref": "models.schema.json#/$defs/jobMetadata" } },
  "required": ["job"],
  "$defs": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "action": {
      "type": "string",
      "enum": ["run", "wait", "status", "output", "cancel", "remove", "list", "version"]
    },
    "jobId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_-]+$" },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9._:-]+$" },
    "jobStatus": {
      "type": "string",
      "enum": [
        "running", "succeeded", "nonzero_exit", "signal_exit", "cancelled",
        "hard_timeout", "output_limit", "runner_lost"
      ]
    },
    "terminalStatus": {
      "type": "string",
      "enum": [
        "succeeded", "nonzero_exit", "signal_exit", "cancelled",
        "hard_timeout", "output_limit", "runner_lost"
      ]
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "malformed_json", "invalid_request", "incompatible_version", "invalid_range",
        "invalid_cursor", "job_not_found", "unauthorized", "active_job", "conflict",
        "corrupt_state", "runner_unavailable", "io_failure", "internal"
      ]
    },
    "exitClass": { "type": "integer", "enum": [0, 2, 3, 4, 5] },
    "timestampUnixMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "byteCursor": { "type": "integer", "minimum": 0, "maximum": 104857600 },
    "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 86400000 },
    "trustedContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": { "$ref": "models.schema.json#/$defs/sessionId" },
        "workspace_path": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "minLength": 1 }
      },
      "required": ["session_id", "workspace_path", "cwd"]
    },
    "runPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "hard_timeout_ms": { "$ref": "models.schema.json#/$defs/timeoutMs" },
        "output_limit_bytes": { "type": "integer", "minimum": 1, "maximum": 104857600 }
      },
      "required": ["command"]
    },
    "jobReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "job_id": { "$ref": "models.schema.json#/$defs/jobId" } },
      "required": ["job_id"]
    },
    "waitPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": { "$ref": "models.schema.json#/$defs/jobId" },
        "cursor_bytes": { "$ref": "models.schema.json#/$defs/byteCursor" },
        "timeout_ms": { "$ref": "models.schema.json#/$defs/timeoutMs" },
        "idle_timeout_ms": { "$ref": "models.schema.json#/$defs/timeoutMs" }
      },
      "required": ["job_id"]
    },
    "outputPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": { "$ref": "models.schema.json#/$defs/jobId" },
        "start_cursor_bytes": { "$ref": "models.schema.json#/$defs/byteCursor" },
        "end_cursor_bytes": { "$ref": "models.schema.json#/$defs/byteCursor" }
      },
      "required": ["job_id"]
    },
    "sessionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "$ref": "models.schema.json#/$defs/schemaVersion" },
        "session_id": { "$ref": "models.schema.json#/$defs/sessionId" },
        "workspace_path": { "type": "string", "minLength": 1 },
        "created_at_unix_ms": { "$ref": "models.schema.json#/$defs/timestampUnixMs" }
      },
      "required": ["schema_version", "session_id", "workspace_path", "created_at_unix_ms"]
    },
    "jobMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": { "$ref": "models.schema.json#/$defs/jobId" },
        "status": { "$ref": "models.schema.json#/$defs/jobStatus" },
        "owner_session_id": { "$ref": "models.schema.json#/$defs/sessionId" },
        "workspace_path": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "created_at_unix_ms": { "$ref": "models.schema.json#/$defs/timestampUnixMs" },
        "started_at_unix_ms": { "$ref": "models.schema.json#/$defs/timestampUnixMs" },
        "finished_at_unix_ms": { "$ref": "models.schema.json#/$defs/timestampUnixMs" },
        "captured_bytes": { "$ref": "models.schema.json#/$defs/byteCursor" },
        "hard_timeout_ms": { "$ref": "models.schema.json#/$defs/timeoutMs" },
        "output_limit_bytes": { "type": "integer", "minimum": 1, "maximum": 104857600 }
      },
      "required": [
        "job_id", "status", "owner_session_id", "workspace_path", "cwd", "command",
        "created_at_unix_ms", "started_at_unix_ms", "captured_bytes",
        "hard_timeout_ms", "output_limit_bytes"
      ]
    },
    "outputChunk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "start_cursor_bytes": { "$ref": "models.schema.json#/$defs/byteCursor" },
        "next_cursor_bytes": { "$ref": "models.schema.json#/$defs/byteCursor" },
        "captured_bytes": { "$ref": "models.schema.json#/$defs/byteCursor" },
        "eof": { "type": "boolean" }
      },
      "required": ["text", "start_cursor_bytes", "next_cursor_bytes", "captured_bytes", "eof"]
    },
    "processResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "$ref": "models.schema.json#/$defs/terminalStatus" },
        "finished_at_unix_ms": { "$ref": "models.schema.json#/$defs/timestampUnixMs" },
        "captured_bytes": { "$ref": "models.schema.json#/$defs/byteCursor" },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "signal": { "type": "integer", "minimum": 1, "maximum": 64 },
        "diagnostic": { "type": "string", "maxLength": 4096 }
      },
      "required": ["status", "finished_at_unix_ms", "captured_bytes"],
      "oneOf": [
        {
          "properties": {
            "status": { "type": "string", "const": "succeeded" },
            "exit_code": { "type": "integer", "const": 0 },
            "signal": false
          },
          "required": ["exit_code"]
        },
        {
          "properties": {
            "status": { "type": "string", "const": "nonzero_exit" },
            "exit_code": { "type": "integer", "minimum": 1, "maximum": 255 },
            "signal": false
          },
          "required": ["exit_code"]
        },
        {
          "properties": {
            "status": { "type": "string", "const": "signal_exit" },
            "exit_code": false,
            "signal": { "type": "integer", "minimum": 1, "maximum": 64 }
          },
          "required": ["signal"]
        },
        {
          "properties": {
            "status": {
              "type": "string",
              "enum": ["cancelled", "hard_timeout", "output_limit"]
            },
            "exit_code": false,
            "signal": { "type": "integer", "minimum": 1, "maximum": 64 }
          }
        },
        {
          "properties": {
            "status": { "type": "string", "const": "runner_lost" },
            "exit_code": false,
            "signal": false,
            "diagnostic": { "type": "string", "minLength": 1, "maxLength": 4096 }
          },
          "required": ["diagnostic"]
        }
      ]
    },
    "cancellationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested": { "type": "boolean", "const": true },
        "requested_at_unix_ms": { "$ref": "models.schema.json#/$defs/timestampUnixMs" },
        "requested_by_session_id": { "$ref": "models.schema.json#/$defs/sessionId" }
      },
      "required": ["requested", "requested_at_unix_ms", "requested_by_session_id"]
    },
    "observerCursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": { "$ref": "models.schema.json#/$defs/sessionId" },
        "cursor_bytes": { "$ref": "models.schema.json#/$defs/byteCursor" },
        "updated_at_unix_ms": { "$ref": "models.schema.json#/$defs/timestampUnixMs" }
      },
      "required": ["session_id", "cursor_bytes", "updated_at_unix_ms"]
    },
    "persistedJobState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "$ref": "models.schema.json#/$defs/schemaVersion" },
        "session": { "$ref": "models.schema.json#/$defs/sessionMetadata" },
        "job": { "$ref": "models.schema.json#/$defs/jobMetadata" },
        "result": { "$ref": "models.schema.json#/$defs/processResult" },
        "cancellation": { "$ref": "models.schema.json#/$defs/cancellationMetadata" },
        "observers": { "type": "array", "items": { "$ref": "models.schema.json#/$defs/observerCursor" } }
      },
      "required": ["schema_version", "session", "job", "observers"],
      "oneOf": [
        {
          "properties": {
            "job": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "const": "running" },
                "finished_at_unix_ms": false
              }
            },
            "result": false
          }
        },
        {
          "properties": {
            "job": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "const": "succeeded" },
                "finished_at_unix_ms": true
              },
              "required": ["finished_at_unix_ms"]
            },
            "result": {
              "type": "object",
              "properties": { "status": { "type": "string", "const": "succeeded" } }
            }
          },
          "required": ["result"]
        },
        {
          "properties": {
            "job": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "const": "nonzero_exit" },
                "finished_at_unix_ms": true
              },
              "required": ["finished_at_unix_ms"]
            },
            "result": {
              "type": "object",
              "properties": { "status": { "type": "string", "const": "nonzero_exit" } }
            }
          },
          "required": ["result"]
        },
        {
          "properties": {
            "job": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "const": "signal_exit" },
                "finished_at_unix_ms": true
              },
              "required": ["finished_at_unix_ms"]
            },
            "result": {
              "type": "object",
              "properties": { "status": { "type": "string", "const": "signal_exit" } }
            }
          },
          "required": ["result"]
        },
        {
          "properties": {
            "job": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "const": "cancelled" },
                "finished_at_unix_ms": true
              },
              "required": ["finished_at_unix_ms"]
            },
            "result": {
              "type": "object",
              "properties": { "status": { "type": "string", "const": "cancelled" } }
            }
          },
          "required": ["result"]
        },
        {
          "properties": {
            "job": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "const": "hard_timeout" },
                "finished_at_unix_ms": true
              },
              "required": ["finished_at_unix_ms"]
            },
            "result": {
              "type": "object",
              "properties": { "status": { "type": "string", "const": "hard_timeout" } }
            }
          },
          "required": ["result"]
        },
        {
          "properties": {
            "job": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "const": "output_limit" },
                "finished_at_unix_ms": true
              },
              "required": ["finished_at_unix_ms"]
            },
            "result": {
              "type": "object",
              "properties": { "status": { "type": "string", "const": "output_limit" } }
            }
          },
          "required": ["result"]
        },
        {
          "properties": {
            "job": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "const": "runner_lost" },
                "finished_at_unix_ms": true
              },
              "required": ["finished_at_unix_ms"]
            },
            "result": {
              "type": "object",
              "properties": { "status": { "type": "string", "const": "runner_lost" } }
            }
          },
          "required": ["result"]
        }
      ]
    },
    "outputObservation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "observation": { "$ref": "models.schema.json#/$defs/jobObservation" },
        "output": { "$ref": "models.schema.json#/$defs/outputChunk" }
      },
      "required": ["observation", "output"]
    },
    "jobObservation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "job": { "$ref": "models.schema.json#/$defs/jobMetadata" },
        "process_result": { "$ref": "models.schema.json#/$defs/processResult" }
      },
      "required": ["job"],
      "oneOf": [
        {
          "properties": {
            "job": { "type": "object", "properties": { "status": { "type": "string", "const": "running" } } },
            "process_result": false
          }
        },
        {
          "properties": {
            "job": { "type": "object", "properties": { "status": { "type": "string", "const": "succeeded" } } },
            "process_result": { "type": "object", "properties": { "status": { "type": "string", "const": "succeeded" } } }
          },
          "required": ["process_result"]
        },
        {
          "properties": {
            "job": { "type": "object", "properties": { "status": { "type": "string", "const": "nonzero_exit" } } },
            "process_result": { "type": "object", "properties": { "status": { "type": "string", "const": "nonzero_exit" } } }
          },
          "required": ["process_result"]
        },
        {
          "properties": {
            "job": { "type": "object", "properties": { "status": { "type": "string", "const": "signal_exit" } } },
            "process_result": { "type": "object", "properties": { "status": { "type": "string", "const": "signal_exit" } } }
          },
          "required": ["process_result"]
        },
        {
          "properties": {
            "job": { "type": "object", "properties": { "status": { "type": "string", "const": "cancelled" } } },
            "process_result": { "type": "object", "properties": { "status": { "type": "string", "const": "cancelled" } } }
          },
          "required": ["process_result"]
        },
        {
          "properties": {
            "job": { "type": "object", "properties": { "status": { "type": "string", "const": "hard_timeout" } } },
            "process_result": { "type": "object", "properties": { "status": { "type": "string", "const": "hard_timeout" } } }
          },
          "required": ["process_result"]
        },
        {
          "properties": {
            "job": { "type": "object", "properties": { "status": { "type": "string", "const": "output_limit" } } },
            "process_result": { "type": "object", "properties": { "status": { "type": "string", "const": "output_limit" } } }
          },
          "required": ["process_result"]
        },
        {
          "properties": {
            "job": { "type": "object", "properties": { "status": { "type": "string", "const": "runner_lost" } } },
            "process_result": { "type": "object", "properties": { "status": { "type": "string", "const": "runner_lost" } } }
          },
          "required": ["process_result"]
        }
      ]
    },
    "cancellationOutcome": {
      "type": "string",
      "enum": ["requested", "already_requested", "already_terminal"]
    },
    "cancellationResult": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "job_id": { "$ref": "models.schema.json#/$defs/jobId" }, "status": { "$ref": "models.schema.json#/$defs/jobStatus" },
        "outcome": { "$ref": "models.schema.json#/$defs/cancellationOutcome" },
        "cancellation": { "$ref": "models.schema.json#/$defs/cancellationMetadata" }
      },
      "required": ["job_id", "status", "outcome"],
      "oneOf": [
        {
          "properties": {
            "outcome": { "type": "string", "const": "requested" },
            "status": { "type": "string", "enum": ["running", "cancelled"] },
            "cancellation": { "$ref": "models.schema.json#/$defs/cancellationMetadata" }
          },
          "required": ["cancellation"]
        },
        {
          "properties": {
            "outcome": { "type": "string", "const": "already_requested" },
            "status": { "$ref": "models.schema.json#/$defs/jobStatus" },
            "cancellation": { "$ref": "models.schema.json#/$defs/cancellationMetadata" }
          },
          "required": ["cancellation"]
        },
        {
          "properties": {
            "outcome": { "type": "string", "const": "already_terminal" },
            "status": { "$ref": "models.schema.json#/$defs/terminalStatus" },
            "cancellation": false
          }
        }
      ]
    },
    "removeResult": {
      "type": "object", "additionalProperties": false,
      "properties": { "job_id": { "$ref": "models.schema.json#/$defs/jobId" }, "removed": { "type": "boolean", "const": true } },
      "required": ["job_id", "removed"]
    },
    "listResult": {
      "type": "object", "additionalProperties": false,
      "properties": { "jobs": { "type": "array", "items": { "$ref": "models.schema.json#/$defs/jobMetadata" } } },
      "required": ["jobs"]
    },
    "versionData": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "binary_version": { "type": "string", "minLength": 1 },
        "protocol_version": { "$ref": "models.schema.json#/$defs/schemaVersion" },
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 }
      },
      "required": ["product", "binary_version", "protocol_version", "os", "architecture"]
    },
    "errorDetails": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 },
        "expected": { "type": "string" }, "actual": { "type": "string" }
      }
    },
    "protocolError": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "code": { "$ref": "models.schema.json#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1 },
        "details": { "$ref": "models.schema.json#/$defs/errorDetails" }
      },
      "required": ["code", "message"]
    }
  }
}
